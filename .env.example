# The key-free demo needs no configuration.
# Optional integrations are for a single-user, loopback-only local environment.
WENDY_ENABLE_LIVE=false
WENDY_ALLOW_EMAIL=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
WENDY_SMTP_USER=
WENDY_SMTP_PASSWORD=
